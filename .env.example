# Copy to .env.local for local development, or set these in Vercel.

# The live domain. When set, the site is indexable (robots index,follow) and canonical/OG URLs use it.
NEXT_PUBLIC_SITE_URL=https://www.antonywilliamscarpentry.co.uk

# Enquiry form delivery via Resend (https://resend.com). Without the key, enquiries are logged
# to the server console and the visitor is told to call or email.
RESEND_API_KEY=re_...
ENQUIRY_FROM_EMAIL="Antony Williams website <website@antonywilliamscarpentry.co.uk>"   # a verified Resend domain
ENQUIRY_TO_EMAIL=thejoinertony@gmail.com
